import os
import json
import re
import hashlib
from concurrent.futures import ThreadPoolExecutor

INPUT_DIR = "."
OUTPUT_DIR = "."

os.makedirs(OUTPUT_DIR, exist_ok=True)


def sanitize_filename(title: str) -> str:
    title = re.sub(r'[^a-zA-Z0-9_-]+', '-', title)
    return title.strip("-").lower()


def hash_string(text: str) -> str:
    return hashlib.md5(text.encode()).hexdigest()[:6]


def try_load_json(text: str, filename: str):
    # Raw load first
    try:
        return json.loads(text)
    except:
        print(f"⚠ Repairing JSON → {filename}")

    # remove possible BOM
    text = text.strip("\ufeff \n\t\r")

    # Replace single quotes with double quotes
    text = re.sub(r"(?<!\\)'", '"', text)

    # Fix missing commas inside objects
    # key"value" → key", "value"
    text = re.sub(r'"\s+"', '", "', text)

    # Remove trailing commas before braces/brackets
    text = re.sub(r",\s*}", "}", text)
    text = re.sub(r",\s*]", "]", text)

    try:
        return json.loads(text)
    except Exception as e:
        print(f"❌ JSON STILL BROKEN → {filename}: {e}")
        return None


def process_file(filepath: str):
    filename = os.path.basename(filepath)

    print(f"📄 Processing → {filename}")

    try:
        with open(filepath, "r", encoding="utf-8", errors="ignore") as f:
            raw = f.read()
    except Exception as e:
        print(f"❌ Cannot read file → {filename}: {e}")
        return

    data = try_load_json(raw, filename)

    if data is None:
        return

    # rewrite repaired json
    with open(filepath, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=4)

    print(f"✔ JSON fixed → {filename}")

    title = data.get("title", "untitled")
    summary = data.get("summary", "")
    tags = data.get("tags", [])
    category = data.get("category", "")
    content = data.get("content", "")

    safe_name = sanitize_filename(title)
    hashed = hash_string(title)

    output_filename = os.path.join(OUTPUT_DIR, f"{safe_name}-{hashed}.md")

    with open(output_filename, "w", encoding="utf-8") as out:
        out.write(f"---\n")
        if category:
            out.write(f"category: {category}\n")
        out.write(f"tags: {tags}\n")
        out.write(f"id: {hashed}\n")
        out.write(f"---\n\n")

        out.write(f"# {title}\n\n")
        if summary:
            out.write(f"**Summary:** {summary}\n\n")
        if content:
            out.write("## Content\n")
            out.write(content + "\n")

    print(f"📝 Created Markdown → {output_filename}\n")


def run_parallel():
    if not os.path.exists(INPUT_DIR):
        print("❌ INPUT_DIR does NOT exist")
        return

    files = [
        os.path.join(INPUT_DIR, f)
        for f in os.listdir(INPUT_DIR)
        if f.endswith(".json")
        and not f.startswith("._")
    ]

    print(f"\n🔍 Found {len(files)} JSON files to process\n")

    if not files:
        print("⚠ No valid .json files found")
        return

    with ThreadPoolExecutor(max_workers=8) as executor:
        executor.map(process_file, files)

    print("\n✅ Completed processing.\n")


if __name__ == "__main__":
    run_parallel()

