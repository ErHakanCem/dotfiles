#!/bin/bash

# --- 1. CONFIGURATION ---
# IMPORTANT: Update these paths if your folders are named differently
INPUT_DIR="."      # Folder containing your chaotic .txt and .md notes
OUTPUT_DIR="./output.json/"      # Folder where the structured .json files will be saved

# --- 2. THE EXTRACTION PROMPT (Embedded) ---
# This prompt uses your specific categories/subtopics and enforces JSON output.
PROMPT="
You are an expert knowledge base architect and archivist. Analyze the provided text note.

Your primary task is to assign a new, concise title and generate a unique categorization string using the strict format: CATEGORY-SUBTOPIC-ID.

Rules for Categorization String:
1.  CATEGORY: Choose ONE from: 'architecture', 'art', 'philosophy', 'politics', 'money', 'memories', 'todos', 'poem', 'programming, 'science', 'projects'.
2.  ID: Assign a unique, random 5-digit number (e.g., '18734').
3.  Format: The final string must be exactly [CATEGORY]-[ID] (e.g., philosophy-8734).

Extract the following information and structure the output strictly in JSON format:

1.  CategoryID: The unique categorization string generated above.
2.  KeyConcepts: A bulleted list (JSON array) of 1-3 essential terms, figures, or concepts mentioned or implied.
3.  **OriginalContent**: The complete, raw text of the input note.

Input Note:
"
# removed
# CoreTheme: The central argument, question, or emotional thesis of the text (1-2 sentences).
# SourceTone: A single, appropriate emotional or intellectual tone (e.g., 'Contemplative', 'Defiant', 'Skeptical', 'Urgent').
#
#
# --- 3. EXECUTION ---

# Create output directory if it doesn't exist
mkdir -p "$OUTPUT_DIR"

echo "Starting Gemini Knowledge Base Extraction (Step 1 - Compatibility Mode)..."
echo "Input Folder: $INPUT_DIR"
echo "Output Folder: $OUTPUT_DIR"
echo "---"

# Loop through every .txt and .md file in the input directory
for input_file in "$INPUT_DIR"/*.{txt,md}; do
    
    if [[ ! -e "$input_file" ]]; then
        echo "No .txt or .md files found in $INPUT_DIR. Exiting."
        # Use a non-fatal exit here if the folder is empty
        continue 
    fi

    # Remove the extension for the output filename
    filename_base=$(basename "$input_file")
    filename=${filename_base%.*}
    
    output_file="$OUTPUT_DIR/$filename.json"

    echo "Processing: $filename (${filename_base})..."

    # *** COMPATIBILITY MODE COMMAND ***
    # This command combines the PROMPT and the content of the input file,
    # and pipes it to the 'gemini' CLI using standard input (-).
    # NOTE: The '-p' flag is used for non-interactive mode; check your CLI documentation
    # if this command still fails.
    
    # (cat $PROMPT and cat $input_file) | gemini -p - > output_file
    (echo "$PROMPT"; cat "$input_file") | gemini -p - > "$output_file"

    if [ $? -eq 0 ]; then
        echo "  [SUCCESS] Saved structured JSON to $output_file"
        echo "  *** NOTE: Please manually verify the file is valid JSON due to CLI limitations. ***"
    else
        echo "  [ERROR] Command failed for $input_file. Check your CLI version or API key."
    fi
    echo ""

done

echo "---"
echo "Extraction process complete! You should now have structured JSON files in the '$OUTPUT_DIR' folder."
